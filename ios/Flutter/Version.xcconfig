// DateWise AI v2 App Store version for iOS.
//
// The live App Store version is 1.0.2 (build 3). v2 ships as 2.0.0 with a
// higher build number. These override FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER
// from Generated.xcconfig (written from pubspec.yaml), so every Xcode archive
// and `flutter build ios|ipa` produces 2.0.0 (4) even while pubspec.yaml still
// says 1.0.2+3.
//
// For each new upload to App Store Connect, raise DW_IOS_BUILD_NUMBER by one.
// Once pubspec.yaml carries `version: 2.0.0+4` (or later), this file can be
// deleted together with its #include lines in Debug.xcconfig / Release.xcconfig.
DW_IOS_VERSION = 2.0.0
DW_IOS_BUILD_NUMBER = 4
FLUTTER_BUILD_NAME = $(DW_IOS_VERSION)
FLUTTER_BUILD_NUMBER = $(DW_IOS_BUILD_NUMBER)
