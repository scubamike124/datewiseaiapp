# DateWise AI — web hosting rules (Apache / cPanel / GoDaddy).

# --- Clean URLs for the legal pages -----------------------------------------
# Serve the standalone pages at extension-less paths, e.g.
#   https://datewiseai.com/privacy-policy   -> privacy.html
#   https://datewiseai.com/terms-of-service -> terms.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^privacy-policy/?$ privacy.html [L,NC]
  RewriteRule ^privacy/?$ privacy.html [L,NC]
  RewriteRule ^terms-of-service/?$ terms.html [L,NC]
  RewriteRule ^terms/?$ terms.html [L,NC]
</IfModule>

# --- Cache control ----------------------------------------------------------
# Flutter web installs a service worker that aggressively caches the app.
# Without this, browsers keep serving the OLD version after a new upload. These
# rules tell the browser never to cache the app shell + service worker, so a new
# deploy shows up immediately. Wrapped in IfModule so it can't error.
<IfModule mod_headers.c>
  <FilesMatch "(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Correct MIME type for the WebAssembly used by the renderer.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
