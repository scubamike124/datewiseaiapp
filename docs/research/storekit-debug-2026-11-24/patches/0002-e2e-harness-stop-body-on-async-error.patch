+/// Errors that escaped the app's own async code during a scenario (a stream
+/// listener throwing, for example). flutter_test ends the test the moment
+/// one is reported while the body keeps running; the body then races the
+/// binding's tear-down and every later scenario fails with `!inTest`. The
+/// scenario body polls this list so it stops, fails once with the real error,
+/// and the next scenario starts clean.
+final _asyncErrors = <FlutterErrorDetails>[];
+
+void _throwIfAsyncError() {
+  if (_asyncErrors.isNotEmpty) {
+    final d = _asyncErrors.first;
+    throw TestFailure('Uncaught async error in the app: ${d.exceptionAsString()}\n${d.stack.toString().split('\n').take(6).join('\n')}');
+  }
